#
# c2c-peek - read 32-bit words from a physical address. An address inside the
# AXI Chip2Chip window is only read when the link is up.

. /usr/share/c2c-tools/c2c-functions.sh

usage() {
	cat <<EOF
Usage: ${0##*/} [-f] ADDRESS [COUNT]
  ADDRESS  physical address, hexadecimal (0x...) or decimal, word aligned
  COUNT    number of consecutive 32-bit words to read (default 1)
  -f       force: skip the link check for an address in the Chip2Chip window
           (0xA0000000 - 0xA0FFFFFF). With the link down the read stalls the bus.
Exit status: 0 done, 1 refused because the link is down, 2 error
EOF
}

force=0
while getopts fh opt; do
	case $opt in
	f) force=1 ;;
	h)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
done
shift $((OPTIND - 1))

[ $# -ge 1 ] && [ $# -le 2 ] || {
	usage >&2
	exit 2
}
addr=$1
count=${2:-1}
c2c_is_num "$addr" || c2c_die "bad address: $addr"
c2c_is_num "$count" || c2c_die "bad count: $count"
[ $((addr & 3)) -eq 0 ] || c2c_die "address is not word aligned: $addr"

c2c_need_root

i=0
while [ "$i" -lt $((count)) ]; do
	a=$(printf '0x%08X' $((addr + 4 * i)))
	c2c_guard "$a" "$force"
	v=$(c2c_rd32 "$a") || c2c_die "read of $a failed"
	echo "$a: $v"
	i=$((i + 1))
done
