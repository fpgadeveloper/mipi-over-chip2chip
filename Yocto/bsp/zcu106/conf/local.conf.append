# MIPI over Chip2Chip overrides for zcu106 (ZynqMP host), EDF flow.
# bsp/zcu106 gets its own MACHINE/SDT from its own Vivado XSA via
# gen-machineconf parse-sdt (PS + PL device tree derived from hardware);
# MACHINE is NOT pinned. Console is the PS UART (ttyPS0). The EDF wks puts the
# rootfs on /dev/mmcblk0p3.
#
# Kernel command line: NOT set here. On the ZynqMP SD boot of the EDF flow the
# kernel command line is /chosen/bootargs of the device tree embedded in
# BOOT.BIN, to which boot.scr appends root=/dev/mmcblk0p3; APPEND never reaches
# the kernel. The bootargs (console, clk_ignore_unused, cma=) are therefore set
# in meta-user/recipes-bsp/device-tree/files/system-user.dtsi.

# Hostname. The distro sets hostname:pn-base-files:amd-edf = "amd-edf": a stacked
# override, which beats a plain hostname:pn-base-files wherever it is assigned
# (the image would come up as "amd-edf"). Only :forcevariable outranks it.
hostname:pn-base-files:forcevariable = "c2c-zcu106"

# Reserve space in the rootfs for image-time installs.
IMAGE_ROOTFS_EXTRA_SPACE = "524288"
